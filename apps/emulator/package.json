{
  "name": "emulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Emulator control center: drive emulated agent sessions (trigger events, run scenarios, inject faults) while product apps run in emulator mode (draft/EMULATOR.md §6).",
  "license": "MIT",
  "author": "James Yong",
  "main": "./dist/main.cjs",
  "scripts": {
    "bundle": "node build.mjs",
    "start": "pnpm bundle && electron .",
    "smoke": "pnpm bundle && electron . --smoke",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5.0",
    "@vibecook/chopsticks-adapter-claude": "workspace:*",
    "@vibecook/chopsticks-emulator": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^43.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
