{
  "name": "chopsticks",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Native TUI coding-agent runtime: host agents' original terminal experiences with managed lifecycle, observation, and guarded control",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecook-dev/chopsticks.git"
  },
  "homepage": "https://github.com/vibecook-dev/chopsticks#readme",
  "bugs": {
    "url": "https://github.com/vibecook-dev/chopsticks/issues"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm typecheck && node --test scripts/*.test.mjs && pnpm -r test",
    "workbench": "pnpm --filter workbench start",
    "workbench:bundle": "pnpm --filter workbench bundle",
    "workbench:smoke": "pnpm --filter workbench smoke",
    "workbench:test": "pnpm --filter workbench test",
    "workbench:typecheck": "pnpm --filter workbench typecheck",
    "godview": "pnpm --filter godview start",
    "godview:bundle": "pnpm --filter godview bundle",
    "godview:smoke": "pnpm --filter godview smoke",
    "godview:test": "pnpm --filter godview test",
    "godview:typecheck": "pnpm --filter godview typecheck",
    "pack:check": "pnpm build && node scripts/pack-check.mjs",
    "release:publish": "pnpm -r --filter './packages/**' typecheck && pnpm -r --filter './packages/**' test && pnpm -r --filter './packages/**' build && node scripts/publish-packages.mjs",
    "release:trust": "node scripts/trust-packages.mjs",
    "format:check": "prettier --check 'packages/*/src/**/*.{ts,tsx}'",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx}'"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
