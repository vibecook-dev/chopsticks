{
  "name": "happy-turn",
  "steps": [
    {
      "at": 0,
      "do": {
        "emit": {
          "event": "UserPromptSubmit",
          "with": {
            "prompt": "$stimulus.text",
            "prompt_id": "$uuid:prompt",
            "session_title": "$sessionTitle",
            "permission_mode": "$permissionMode"
          }
        }
      }
    },
    {
      "at": 50,
      "do": {
        "transcript": {
          "record": {
            "type": "assistant",
            "uuid": "$uuid:assistant",
            "sessionId": "$sessionId",
            "timestamp": "$now",
            "cwd": "$cwd",
            "version": "$vendorVersion",
            "message": {
              "id": "$uuid:message",
              "role": "assistant",
              "model": "emulator",
              "content": [{ "type": "text", "text": "$reply" }]
            }
          }
        }
      }
    },
    {
      "at": 100,
      "do": {
        "emit": {
          "event": "Stop",
          "with": {
            "prompt_id": "$uuid:prompt",
            "last_assistant_message": "$reply",
            "stop_hook_active": false,
            "background_tasks": [],
            "session_crons": [],
            "effort": { "level": "xhigh" },
            "permission_mode": "$permissionMode"
          }
        }
      }
    }
  ]
}
