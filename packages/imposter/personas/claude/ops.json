{
  "session.start": [
    {
      "channel": "hook",
      "event": "SessionStart",
      "with": { "source": "$op.source", "session_title": "$sessionTitle" }
    }
  ],
  "session.ready": [
    {
      "channel": "hook",
      "event": "InstructionsLoaded",
      "with": { "file_path": "$claudeMdPath", "memory_type": "User", "load_reason": "session_start" }
    }
  ],
  "session.end": [
    {
      "channel": "hook",
      "event": "SessionEnd",
      "with": { "reason": "$op.reason", "prompt_id": "$uuid:prompt" }
    }
  ],
  "turn.start": [
    {
      "channel": "hook",
      "event": "UserPromptSubmit",
      "with": {
        "prompt": "$op.text",
        "prompt_id": "$uuid:prompt",
        "session_title": "$sessionTitle",
        "permission_mode": "$permissionMode"
      }
    },
    {
      "channel": "transcript",
      "with": {
        "type": "user",
        "uuid": "$uuid:user",
        "promptId": "$uuid:prompt",
        "sessionId": "$sessionId",
        "timestamp": "$now",
        "cwd": "$cwd",
        "version": "$vendorVersion",
        "message": { "role": "user", "content": "$op.text" }
      }
    }
  ],
  "assistant.delta": [
    {
      "channel": "transcript",
      "with": {
        "type": "assistant",
        "uuid": "$uuid:assistant",
        "sessionId": "$sessionId",
        "timestamp": "$now",
        "cwd": "$cwd",
        "version": "$vendorVersion",
        "message": {
          "id": "$uuid:message",
          "role": "assistant",
          "model": "$modelId",
          "content": [{ "type": "text", "text": "$op.text" }]
        }
      }
    }
  ],
  "permission.ask": [
    {
      "channel": "hook",
      "event": "PermissionRequest",
      "with": {
        "tool_name": "$op.tool",
        "tool_input": "$op.input",
        "prompt_id": "$uuid:prompt",
        "permission_mode": "$permissionMode",
        "permission_suggestions": [],
        "effort": { "level": "xhigh" }
      }
    }
  ],
  "tool.start": [
    {
      "channel": "hook",
      "event": "PreToolUse",
      "with": {
        "tool_name": "$op.tool",
        "tool_input": "$op.input",
        "tool_use_id": "$uuid:tool",
        "prompt_id": "$uuid:prompt",
        "permission_mode": "$permissionMode",
        "effort": { "level": "xhigh" }
      }
    }
  ],
  "tool.end": [
    {
      "channel": "hook",
      "event": "PostToolUse",
      "with": {
        "tool_name": "$op.tool",
        "tool_input": "$op.input",
        "tool_response": "$op.output",
        "tool_use_id": "$uuid:tool",
        "prompt_id": "$uuid:prompt",
        "permission_mode": "$permissionMode",
        "duration_ms": 42,
        "effort": { "level": "xhigh" }
      }
    }
  ],
  "turn.end": [
    {
      "channel": "hook",
      "event": "Stop",
      "with": {
        "prompt_id": "$uuid:prompt",
        "last_assistant_message": "$op.text",
        "stop_hook_active": false,
        "background_tasks": [],
        "session_crons": [],
        "permission_mode": "$permissionMode",
        "effort": { "level": "xhigh" }
      }
    }
  ],
  "usage.refresh": [{ "channel": "statusline" }]
}
