{
  "name": "@vibecook/chopsticks-imposter",
  "version": "0.1.8",
  "type": "module",
  "description": "One executable that impersonates every coding agent: speaks each vendor's real machine surfaces (hooks, transcripts, statuslines, JSON-RPC) from its captured Agent Surface Model (draft/IMPOSTER.md).",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecook-dev/chopsticks.git",
    "directory": "packages/imposter"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli/main.ts",
    "./control": "./src/control/index.ts",
    "./machine": "./src/session/machine.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./cli": {
        "types": "./dist/cli/main.d.ts",
        "import": "./dist/cli/main.js"
      },
      "./control": {
        "types": "./dist/control/index.d.ts",
        "import": "./dist/control/index.js"
      },
      "./machine": {
        "types": "./dist/session/machine.d.ts",
        "import": "./dist/session/machine.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "bin",
    "personas"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vibecook/chopsticks-surface": "workspace:*",
    "ink": "^7.1.1",
    "react": "^19.2.7",
    "xstate": "^5.32.5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@vibecook/chopsticks-adapter-claude": "workspace:*",
    "@vibecook/chopsticks-adapter-codex": "workspace:*",
    "@vibecook/chopsticks-core": "workspace:*",
    "@vibecook/chopsticks-testing": "workspace:*"
  },
  "bin": {
    "ai": "./bin/ai.mjs",
    "imposter": "./bin/ai.mjs"
  }
}
