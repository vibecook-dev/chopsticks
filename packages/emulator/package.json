{
  "name": "@vibecook/chopsticks-emulator",
  "version": "0.1.3",
  "type": "module",
  "description": "Agent Surface Model (ASM) runtime and vendor-neutral emulator engine: validate, load, audit, and emulate captured vendor surfaces (draft/EMULATOR.md).",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesyong-42/chopsticks.git",
    "directory": "packages/emulator"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts",
    "./engine": "./src/engine.ts",
    "./control": "./src/control.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./model": {
        "types": "./dist/model.d.ts",
        "import": "./dist/model.js"
      },
      "./engine": {
        "types": "./dist/engine.d.ts",
        "import": "./dist/engine.js"
      },
      "./control": {
        "types": "./dist/control.d.ts",
        "import": "./dist/control.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "ui"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  }
}
