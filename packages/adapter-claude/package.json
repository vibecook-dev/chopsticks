{
  "name": "@vibecook/chopsticks-adapter-claude",
  "version": "0.1.9",
  "type": "module",
  "description": "Claude Code native adapter: hook registry, loopback hook bridge, event normalizer, settings generation.",
  "license": "MIT",
  "author": "James Yong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecook-dev/chopsticks.git",
    "directory": "packages/adapter-claude"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "surface/model"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "surface:audit": "node surface/audit.mjs",
    "surface:privacy": "node surface/sanitize-captures.mjs --check surface/captures/claude@2.1.207",
    "surface:sanitize": "node surface/sanitize-captures.mjs surface/captures-raw/claude@2.1.207 surface/captures/claude@2.1.207",
    "generate:registry": "node surface/generate-registry.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@vibecook/chopsticks-core": "workspace:*",
    "@vibecook/spaghetti-sdk": "0.5.16"
  },
  "devDependencies": {
    "@vibecook/chopsticks-surface": "workspace:*",
    "@vibecook/chopsticks-testing": "workspace:*"
  }
}
